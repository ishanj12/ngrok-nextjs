  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "dotenv": "17.4.2",
    "jiti": "2.7.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
